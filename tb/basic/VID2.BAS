10 REM COCO 2 PMODE AND NTSC ARTIFACT COLOR TEST
20 REM REQUIRES EXTENDED COLOR BASIC 2
30 CLS
40 PRINT "COCO 2 VIDEO TEST"
50 PRINT "PMODE 0 THROUGH 4"
60 PRINT "BOTH VDG COLOR SETS"
70 PRINT "PRESS A KEY TO BEGIN"
80 GOSUB 9000
100 FOR S=0 TO 1
110 FOR M=0 TO 4
120 CLS
130 PRINT "PMODE";M;" COLOR SET";S
140 IF M=0 THEN PRINT "128 X 96 - 2 COLOR"
150 IF M=1 THEN PRINT "128 X 96 - 4 COLOR"
160 IF M=2 THEN PRINT "128 X 192 - 2 COLOR"
170 IF M=3 THEN PRINT "128 X 192 - 4 COLOR"
180 IF M=4 THEN PRINT "256 X 192 - 2 COLOR"
190 IF S=0 AND (M=0 OR M=2 OR M=4) THEN PRINT "BLACK / GREEN"
200 IF S=1 AND (M=0 OR M=2 OR M=4) THEN PRINT "BLACK / BUFF"
210 IF S=0 AND (M=1 OR M=3) THEN PRINT "GREEN YELLOW BLUE RED"
220 IF S=1 AND (M=1 OR M=3) THEN PRINT "BUFF CYAN MAGENTA ORANGE"
230 PRINT "PRESS A KEY"
240 GOSUB 9000
250 PMODE M,1
260 PCLS 0
270 SCREEN 1,S
280 IF M=0 OR M=2 OR M=4 THEN GOSUB 2000
290 IF M=1 OR M=3 THEN GOSUB 2100
300 GOSUB 9000
310 SCREEN 0,1
320 NEXT M
330 NEXT S
1000 CLS
1010 PRINT "PMODE 4 NTSC ARTIFACT TEST"
1020 PRINT "F11 TO TOGGLE ARTIFACT COLOR"
1030 PRINT "PRESS A KEY"
1040 GOSUB 9000
1050 FOR S=0 TO 1
1060 PMODE 4,1
1070 PCLS 0
1080 SCREEN 1,S
1090 COLOR 1,0
1100 LINE (8,24)-(247,55),PSET,BF
1110 FOR X=8 TO 247 STEP 2
1120 LINE (X,72)-(X,103),PSET
1130 NEXT X
1140 FOR X=9 TO 247 STEP 2
1150 LINE (X,120)-(X,151),PSET
1160 NEXT X
1170 GOSUB 9000
1180 SCREEN 0,1
1190 NEXT S
1200 CLS
1210 PRINT "VIDEO TEST COMPLETE"
1220 PRINT "PRESS A KEY TO RUN AGAIN"
1230 GOSUB 9000
1240 RUN
2000 COLOR 0,0
2010 LINE (8,40)-(119,151),PSET,BF
2020 COLOR 1,0
2030 LINE (136,40)-(247,151),PSET,BF
2040 RETURN
2100 COLOR 0,0
2110 LINE (8,24)-(119,87),PSET,BF
2120 COLOR 1,0
2130 LINE (136,24)-(247,87),PSET,BF
2140 COLOR 2,0
2150 LINE (8,104)-(119,167),PSET,BF
2160 COLOR 3,0
2170 LINE (136,104)-(247,167),PSET,BF
2180 RETURN
9000 REM WAIT FOR A COMPLETE KEYPRESS
9010 IF INKEY$<>"" THEN 9010
9020 IF INKEY$="" THEN 9020
9030 IF INKEY$<>"" THEN 9030
9040 RETURN
