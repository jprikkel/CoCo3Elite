10 CLS:PRINT "GIME VECTOR PAGE TEST"
20 I=PEEK(&HFF90):J=PEEK(&HFF91) AND 1:M=PEEK(&HFFA7+8*J)
25 IF (I AND 64)<>0 AND (M AND 15)<>15 THEN PRINT "SKIP: NONSTANDARD MMU MAP":GOTO 110
30 POKE &HFF90,(I OR 8):F=PEEK(&HFE00):T=255-F
40 POKE &HFE00,T:Q=PEEK(&HFE00):POKE &HFE00,F
50 POKE &HFF90,(I AND 247):A=PEEK(&HFE00):U=255-A
60 POKE &HFE00,U:W=PEEK(&HFE00):POKE &HFE00,A
70 POKE &HFF90,I
80 PRINT "FIXED RAM WRITE ";:IF Q=T THEN PRINT "PASS" ELSE PRINT "FAIL"
90 PRINT "MAPPED RAM WRITE ";:IF W=U THEN PRINT "PASS" ELSE PRINT "FAIL"
100 IF Q=T AND W=U THEN PRINT "VECTOR PAGE PASS" ELSE PRINT "VECTOR PAGE FAIL"
105 PRINT "PAGE ISOLATION TESTED IN RTL"
110 PRINT:PRINT "PRESS A KEY";
120 IF INKEY$="" THEN 120
130 RUN "TESTMENU"
