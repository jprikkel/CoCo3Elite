10 REM GIME PALETTE AND LEGACY PMODE COLOR TEST
20 DIM P(15),C(15):F=0:G=0
30 DATA 18,54,9,36,63,27,45,38,0,18,0,63,0,18,0,38
35 DATA 18,36,11,7,63,31,9,38,0,18,0,63,0,18,0,38
40 FOR I=0 TO 15:READ P(I):NEXT I
45 FOR I=0 TO 15:READ C(I):NEXT I
50 CLS:PRINT "GIME PALETTE TEST"
60 PRINT "CURRENT $FFB0-$FFBF:"
70 FOR I=0 TO 15
80 V=PEEK(65456+I):H$=HEX$(V):IF LEN(H$)=1 THEN H$="0"+H$
85 PRINT H$;" ";:IF V<>P(I) THEN F=1
87 IF V<>C(I) THEN G=1
90 IF I=7 THEN PRINT
100 NEXT I:PRINT
105 IF F=0 THEN PRINT "RGB TABLE: PASS":GOTO 107
106 IF G=0 THEN PRINT "COMPOSITE TABLE: PASS - HDMI CONVERTS" ELSE PRINT "STARTUP TABLE: FAIL"
107 PRINT
110 PRINT "PRESS A KEY TO VERIFY RGB TABLE"
120 GOSUB 9000
130 FOR I=0 TO 15:POKE 65456+I,P(I):NEXT I
140 F=0:FOR I=0 TO 15:IF PEEK(65456+I)<>P(I) THEN F=1
142 NEXT I:CLS:PRINT "RGB PALETTE WRITE/READ"
145 IF F=0 THEN PRINT "PASS" ELSE PRINT "FAIL"
150 PRINT "EXPECTED PMODE 1/3 COLORS:"
160 PRINT "SET 0 GREEN YELLOW BLUE RED"
170 PRINT "SET 1 BUFF CYAN MAGENTA ORANGE"
180 PRINT "PRESS A KEY TO TEST"
190 GOSUB 9000
200 FOR M=1 TO 3 STEP 2
210 FOR S=0 TO 1
220 PMODE M,1:PCLS 0:SCREEN 1,S
230 COLOR 1,0:LINE(0,0)-(63,191),PSET,BF
240 COLOR 2,0:LINE(64,0)-(127,191),PSET,BF
250 COLOR 3,0:LINE(128,0)-(191,191),PSET,BF
260 COLOR 4,0:LINE(192,0)-(255,191),PSET,BF
270 GOSUB 9000
280 SCREEN 0,1
290 CLS:PRINT "PMODE";M;" SET";S;" COMPLETE"
300 PRINT "PRESS A KEY FOR NEXT TEST"
310 GOSUB 9000
320 NEXT S
330 NEXT M
340 CLS:PRINT "PALETTE TEST COMPLETE"
350 PRINT "REPORT THE 16 VALUES AND WHETHER"
360 PRINT "THE TWO COLOR SETS WERE CORRECT."
370 END
9000 IF INKEY$<>"" THEN 9000
9010 K$=INKEY$:IF K$="" THEN 9010
9020 IF INKEY$<>"" THEN 9020
9030 RETURN
