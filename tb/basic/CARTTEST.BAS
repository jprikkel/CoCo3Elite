10 REM NON-DESTRUCTIVE DIAGNOSTIC CARTRIDGE TEST
20 CLS:PRINT "CARTRIDGE INTERFACE TEST":PRINT
30 PRINT "DEBUG WINDOW...";:F=0
40 IF PEEK(65395)<>195 THEN F=1
50 IF F=0 THEN PRINT "PASS" ELSE PRINT "FAIL":GOTO 300
60 PRINT "ROM SIZE: 8192 BYTES"
70 PRINT "SAMPLED CHECKSUMS..."
80 F=0
85 FOR N=0 TO 2:S=0:O=N*2048
90 FOR A=O TO O+255
100 POKE 65392,A AND 255:POKE 65393,INT(A/256)
110 D=PEEK(65394):V=PEEK(65394)
120 S=S+V:IF S>65535 THEN S=S-65536
140 NEXT A
150 H$=HEX$(S):IF LEN(H$)<4 THEN H$=STRING$(4-LEN(H$),"0")+H$
160 PRINT "BLOCK";N;" $";H$;
165 E=23644:IF N=1 THEN E=27613
167 IF N=2 THEN E=29611
170 IF S=E THEN PRINT " PASS" ELSE PRINT " FAIL":F=1
180 NEXT N
190 PRINT "SAMPLED IMAGE READ COMPLETE"
210 POKE 65392,0:POKE 65393,0:D=PEEK(65394)
220 IF PEEK(65394)=26 THEN PRINT "ENTRY OPCODE: PASS" ELSE PRINT "ENTRY OPCODE: FAIL":F=1
230 PRINT "CART IRQ IDLE...";
240 V=PEEK(65315)
250 IF (V AND 128)=0 THEN PRINT "PASS" ELSE PRINT "FAIL":F=1
300 PRINT
310 IF F=0 THEN PRINT "CARTRIDGE PREREQUISITES: PASS" ELSE PRINT "CARTRIDGE PREREQUISITES: FAIL"
320 PRINT "THIS TEST DOES NOT EXECUTE THE CART."
330 PRINT "IT ISOLATES IMAGE/MAPPING FROM F3."
340 PRINT:PRINT "PRESS ANY KEY FOR MENU"
350 IF INKEY$="" THEN 350
360 RUN "TESTMENU"
