10 REM COCO 3 VIDEO MODE AND COLOR TEST
20 REM REQUIRES EXTENDED COLOR BASIC 2
30 CLS
40 PRINT "COCO 3 VIDEO MODE TEST"
50 PRINT
60 PRINT "THIS PROGRAM TESTS:"
70 PRINT " PMODE 0 THROUGH 4"
80 PRINT " HSCREEN 1 THROUGH 4"
90 PRINT " THE 16 COCO 3 LOGICAL COLORS"
100 PRINT
110 PRINT "PRESS A KEY TO BEGIN"
120 GOSUB 9000

130 REM --------------------------------
140 REM TEST STANDARD PMODE GRAPHICS

150 FOR S=0 TO 1

160 FOR M=0 TO 4
170 CLS
180 PRINT "STANDARD PMODE TEST"
190 PRINT "SCREEN COLOR TYPE";0

200 PRINT "PMODE";M
210 IF M=0 OR M=1 THEN PRINT "128 X 96"
220 IF M=2 OR M=3 THEN PRINT "128 X 192"
230 IF M=4 THEN PRINT "256 X 192"
240 PRINT
250 PRINT "PRESS A KEY"
260 GOSUB 9000

270 PMODE M,1
280 PCLS 0
290 SCREEN 1,S
295 COLOR 1,0
300 REM DRAW CROSSING LINES
310 FOR X=0 TO 255 STEP 16
320 LINE (X,0)-(255-X,191),PSET
330 NEXT X
335 COLOR 1,0
340 REM DRAW CIRCLES
350 FOR R=10 TO 90 STEP 10
360 CIRCLE (128,96),R
370 NEXT R

375 COLOR 0,0
376 LINE (10,10)-(20,20),PSET,BF
375 COLOR 1,0
376 LINE (10,20)-(20,30),PSET,BF
375 COLOR 2,0
376 LINE (20,10)-(30,20),PSET,BF
375 COLOR 3,0
376 LINE (20,10)-(30,20),PSET,BF

400 GOSUB 9000
410 SCREEN 0,1
420 NEXT M

430 NEXT S

440 REM TEST COCO 3 HSCREEN MODES
450 REM --------------------------------

460 FOR M=1 TO 4
470 HSCREEN M
480 HCLS 0
490 PALETTE 0,0
500 PALETTE 1,63

375 HCOLOR 0,0
376 LINE (10,10)-(20,20),PSET,BF
375 HCOLOR 1,0
376 LINE (10,20)-(20,30),PSET,BF
375 HCOLOR 2,0
376 LINE (20,10)-(30,20),PSET,BF
375 HCOLOR 3,0
376 LINE (20,10)-(30,20),PSET,BF

510 HCOLOR 1,0
520 IF M=1 THEN HPRINT (4,4),"HSCREEN 1 - 320 X 192 - 4 COLOR"
530 IF M=2 THEN HPRINT (4,4),"HSCREEN 2 - 320 X 192 - 16 COLOR"
540 IF M=3 THEN HPRINT (4,4),"HSCREEN 3 - 640 X 192 - 2 COLOR"
550 IF M=4 THEN HPRINT (4,4),"HSCREEN 4 - 640 X 192 - 4 COLOR"

560 HPRINT (4,24),"GRAPHICS TEST"
570 HPRINT (4,40),"PRESS A KEY FOR NEXT MODE"
580 GOSUB 9000
590 NEXT M

600 REM --------------------------------
610 REM TEST ALL 16 LOGICAL COLORS
620 REM HSCREEN 2 = 320 X 192, 16 COLORS
630 REM --------------------------------

640 HSCREEN 2
650 HCLS 0

660 REM ASSIGN 16 DISTINCT GIME PALETTE VALUES
670 PALETTE 0,0
680 PALETTE 1,3
690 PALETTE 2,12
700 PALETTE 3,15
710 PALETTE 4,20
720 PALETTE 5,24
730 PALETTE 6,27
740 PALETTE 7,31
750 PALETTE 8,32
760 PALETTE 9,36
770 PALETTE 10,39
780 PALETTE 11,43
790 PALETTE 12,48
800 PALETTE 13,51
810 PALETTE 14,60
820 PALETTE 15,63

830 DIM N$(15)
840 N$(0)="BLACK"
850 N$(1)="RED"
860 N$(2)="GREEN"
870 N$(3)="YELLOW"
880 N$(4)="BLUE"
890 N$(5)="MAGENTA"
900 N$(6)="CYAN"
910 N$(7)="ORANGE"
920 N$(8)="DARK GRAY"
930 N$(9)="LIGHT RED"
940 N$(10)="LIGHT GREEN"
950 N$(11)="LIGHT YELLOW"
960 N$(12)="LIGHT BLUE"
970 N$(13)="LIGHT MAGENTA"
980 N$(14)="LIGHT CYAN"
990 N$(15)="WHITE"

1000 REM DRAW 4 BY 4 COLOR GRID
1010 FOR C=0 TO 15
1015 REM COL=C MOD 4
1020 COL=C-INT(C/4)*4
1030 ROW=INT(C/4)

1040 X1=COL*80
1050 Y1=ROW*44+2
1060 X2=X1+79
1070 Y2=Y1+43

1080 REM DRAW BORDER
1090 HCOLOR C,0
1100 HLINE (X1,Y1)-(X2,Y1),PSET
1110 HLINE (X2,Y1)-(X2,Y2),PSET
1120 HLINE (X2,Y2)-(X1,Y2),PSET
1130 HLINE (X1,Y2)-(X1,Y1),PSET

1140 REM FILL BOX
1150 HPAINT (X1+3,Y1+3),C

1160 REM USE WHITE TEXT FOR READABILITY
1170 HCOLOR 15,0
1180 HPRINT (X1+3,Y1+3),N$(C)
1190 NEXT C

1200 HCOLOR 15,0
1210 HPRINT (4,180),"16 COLOR TEST - PRESS A KEY"
1220 GOSUB 9000

1230 REM --------------------------------
1240 REM FINISH
1250 REM --------------------------------

1260 HSCREEN 0
1270 WIDTH 32
1280 CLS
1290 PRINT "VIDEO TEST COMPLETE"
1300 PRINT
1310 PRINT "PRESS A KEY TO RUN AGAIN"
1320 GOSUB 9000
1330 RUN

9000 REM WAIT FOR A COMPLETE KEYPRESS
9010 IF INKEY$<>"" THEN 9010
9020 IF INKEY$="" THEN 9020
9030 IF INKEY$<>"" THEN 9030
9040 RETURN
