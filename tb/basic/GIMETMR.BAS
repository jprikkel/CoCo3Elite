10 CLS:PRINT "GIME TIMER REGISTER TEST"
20 A=PEEK(&HFF91):B=PEEK(&HFF94):C=PEEK(&HFF95)
30 POKE &HFF95,&H5A:POKE &HFF94,&H0A
40 D=PEEK(&HFF94):E=PEEK(&HFF95)
50 PRINT "FF94=";HEX$(D);" EXPECT 0A"
60 PRINT "FF95=";HEX$(E);" EXPECT 5A"
70 IF D=&H0A AND E=&H5A THEN PRINT "REGISTER TEST PASS" ELSE PRINT "REGISTER TEST FAIL"
80 POKE &HFF95,C:POKE &HFF94,B:POKE &HFF91,A
90 PRINT:PRINT "RTL TEST VERIFIES BLINK PHASE"
100 PRINT "PRESS A KEY";
110 IF INKEY$="" THEN 110
120 RUN "TESTMENU"
