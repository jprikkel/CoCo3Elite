10 WIDTH 32:CLEAR 200,&H5FFF:CLS
20 PRINT "CARTRIDGE VIDEO PROBE V2"
30 PRINT "SIX CASES - NO RTL CHANGES"
40 PRINT "EXPECT 25 ROWS OF A-Z TEXT"
50 PRINT "KEY RETURNS; TIMEOUT ALSO RETURNS"
60 PRINT "RESTORES BASIC AFTER EACH CASE"
70 LOADM "VIDHELP"
80 DIM R(6),V(6)
90 FOR T=1 TO 6
100 CLS:PRINT "CASE";T;"OF 6"
110 ON T GOSUB 1000,1010,1020,1030,1040,1050
120 PRINT "PRESS A KEY TO START":GOSUB 9000
130 POKE &H6003,T:EXEC &H6000
140 R(T)=PEEK(&H6004)
150 IF PEEK(&H6005)<>254 THEN R(T)=R(T) OR 8
160 CLS:PRINT "CASE";T;"RETURNED"
170 IF R(T)=0 THEN PRINT "REGISTER/RAM CHECK PASS" ELSE PRINT "CHECK FAIL BITS=";HEX$(R(T))
180 PRINT "TEXT CLEAR AND CORRECT WIDTH?"
190 PRINT "Y=YES N=NO"
195 A$=INKEY$
200 IF A$<>"Y" AND A$<>"y" AND A$<>"N" AND A$<>"n" THEN 195
210 V(T)=0:IF A$="Y" OR A$="y" THEN V(T)=1
220 NEXT T
230 CLS:PRINT "VIDEO PROBE SUMMARY"
240 PRINT "CASE CHECK VISUAL"
250 FOR T=1 TO 6:PRINT T;" ";HEX$(R(T));" ";V(T):NEXT T
260 PRINT "CHECK 0=PASS; VISUAL 1=PASS"
270 PRINT "REPORT SIX SUMMARY ROWS"
280 PRINT "PRESS A KEY FOR MENU":GOSUB 9000
290 RUN "TESTMENU"
1000 PRINT "40 COL CARTRIDGE MODE SETTINGS":RETURN
1010 PRINT "40 COL + CLEAR SCROLL/OFFSETS":RETURN
1020 PRINT "40 COL WITH COLOR ATTRIBUTES":RETURN
1030 PRINT "80 COL WITHOUT ATTRIBUTES":RETURN
1040 PRINT "32 COL NATIVE GIME TEXT":RETURN
1050 PRINT "40 COL AT ALTERNATE RAM ADDRESS":RETURN
9000 IF INKEY$<>"" THEN 9000
9010 IF INKEY$="" THEN 9010
9020 IF INKEY$<>"" THEN 9020
9030 RETURN
