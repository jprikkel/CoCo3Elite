10 CLS
20 PRINT "CPU AND RAM TEST"
30 PRINT "MEM FREE:";MEM
40 PRINT "MEMORY CAPACITY...";
50 L=&H7FFE:H=L+65536:LV=LPEEK(L):HV=LPEEK(H)
60 LPOKE L,85:LPOKE H,170
70 IF LPEEK(L)=85 THEN K=128 ELSE K=64
80 LPOKE H,HV:LPOKE L,LV
90 IF K<128 THEN 200
100 H=&H17FFE:X=H+131072:HV=LPEEK(H):XV=LPEEK(X)
110 LPOKE H,51:LPOKE X,204
120 IF LPEEK(H)=51 THEN K=256 ELSE K=128
130 LPOKE X,XV:LPOKE H,HV
140 IF K<256 THEN 200
150 Y=H+262144:HV=LPEEK(H):YV=LPEEK(Y)
160 LPOKE H,15:LPOKE Y,240
170 IF LPEEK(H)=15 THEN K=512 ELSE K=256
180 LPOKE Y,YV:LPOKE H,HV
200 PRINT K;"K DETECTED"
210 IF K<128 THEN PRINT "FAIL: EXPECTED AT LEAST 128K":GOTO 500
220 PRINT "CPU ARITHMETIC...";
230 S=0
240 FOR I=1 TO 100
250 S=S+I
260 NEXT I
270 IF S<>5050 THEN PRINT "FAIL RESULT";S:GOTO 500
280 PRINT "PASS"
290 PRINT "ARRAY RAM...";
300 DIM A(255)
310 FOR I=0 TO 255:A(I)=I:NEXT I
320 FOR I=0 TO 255
330 IF A(I)<>I THEN PRINT "FAIL AT";I:GOTO 500
340 NEXT I
350 PRINT "PASS"
360 PRINT "REPEATED RAM...";
370 FOR P=1 TO 4:FOR I=0 TO 255:A(I)=I+P:NEXT I:NEXT P
380 PRINT "PASS"
390 PRINT "ALL CPU/RAM TESTS PASSED"
500 PRINT:PRINT "PRESS ANY KEY FOR MENU"
510 IF INKEY$="" THEN 510
520 RUN "TESTMENU"
