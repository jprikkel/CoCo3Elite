10 REM NON-DESTRUCTIVE GIME FUNDAMENTAL TESTS
20 DIM S(15),E(15),C(15):F=0:G=0:T=0
30 DATA 18,54,9,36,63,27,45,38,0,18,0,63,0,18,0,38
35 DATA 18,36,11,7,63,31,9,38,0,18,0,63,0,18,0,38
40 FOR I=0 TO 15:READ E(I):NEXT I
45 FOR I=0 TO 15:READ C(I):NEXT I
50 CLS:PRINT "GIME FUNDAMENTAL TESTS":PRINT
60 PRINT "1 STARTUP PALETTE...";
70 FOR I=0 TO 15:V=PEEK(65456+I):S(I)=V
80 IF V<>E(I) THEN F=1
85 IF V<>C(I) THEN G=1
90 NEXT I
100 IF F=0 THEN PRINT "PASS - RGB":GOTO 110
105 IF G=0 THEN PRINT "PASS - COMPOSITE/HDMI" ELSE PRINT "FAIL"
110 PRINT "  ACTUAL: ";
120 FOR I=0 TO 15:H$=HEX$(S(I)):IF LEN(H$)=1 THEN H$="0"+H$
130 PRINT H$;:IF I<15 THEN PRINT " ";
140 NEXT I:PRINT
150 T=T+1:IF F AND G THEN T=T+100
160 PRINT "2 PALETTE RAM...";:F=0
170 FOR I=0 TO 15:POKE 65456+I,(I*5+3) AND 63:NEXT I
180 FOR I=0 TO 15:IF PEEK(65456+I)<>((I*5+3) AND 63) THEN F=1
190 NEXT I
200 FOR I=0 TO 15:POKE 65456+I,S(I):NEXT I
210 IF F=0 THEN PRINT "PASS" ELSE PRINT "FAIL"
220 T=T+1:IF F THEN T=T+100
230 PRINT "3 PALETTE 6-BIT MASK...";:V=S(15)
240 POKE 65471,255:F=(PEEK(65471)<>63):POKE 65471,V
250 IF F=0 THEN PRINT "PASS" ELSE PRINT "FAIL"
260 T=T+1:IF F THEN T=T+100
270 PRINT "4 INACTIVE MMU TASK...";:F=0
280 Q=PEEK(65425) AND 1:B=65440:IF Q=0 THEN B=65448
290 FOR I=0 TO 7:S(I)=PEEK(B+I):NEXT I
300 FOR I=0 TO 7:POKE B+I,(I*7+5) AND 63:NEXT I
310 FOR I=0 TO 7:IF PEEK(B+I)<>((I*7+5) AND 63) THEN F=1
320 NEXT I
330 FOR I=0 TO 7:POKE B+I,S(I):NEXT I
340 IF F=0 THEN PRINT "PASS" ELSE PRINT "FAIL"
350 T=T+1:IF F THEN T=T+100
360 PRINT "5 INIT REGISTER READ...";:F=0
370 A=PEEK(65424):B=PEEK(65425)
380 IF A=255 OR B=255 THEN F=1
390 IF F=0 THEN PRINT "PASS" ELSE PRINT "FAIL"
400 PRINT "  FF90=$";HEX$(A);" FF91=$";HEX$(B)
410 T=T+1:IF F THEN T=T+100
420 PRINT:IF T<100 THEN PRINT "GIME FUNDAMENTALS: PASS" ELSE PRINT "GIME FUNDAMENTALS: FAIL"
430 PRINT "TESTS RUN:";T MOD 100;" OF 5"
440 PRINT:PRINT "PRESS ANY KEY FOR MENU"
450 IF INKEY$="" THEN 450
460 RUN "TESTMENU"
