10 CLS
20 PRINT "VIDEO MODE TEST"
30 PRINT "PMODE 0-4, THEN HSCREEN 1-4"
40 PRINT "EACH PROMPT WAITS FOR A NEW KEYPRESS"
50 GOSUB 9000
60 FOR M=0 TO 4
70 CLS:PRINT "NEXT: PMODE";M
80 IF M=0 OR M=1 THEN PRINT "RESOLUTION: 128 X 96" ELSE IF M=2 OR M=3 THEN PRINT "RESOLUTION: 128 X 192" ELSE PRINT "RESOLUTION: 256 X 192"
90 PRINT "PRESS A KEY TO DISPLAY IT"
100 GOSUB 9000
110 PMODE M,1:PCLS:SCREEN 1,1
120 FOR X=0 TO 255 STEP 16:LINE(X,0)-(255-X,191),PSET:NEXT X
130 FOR R=10 TO 90 STEP 10:CIRCLE(128,96),R:NEXT R
140 GOSUB 9000
150 SCREEN 0,1
160 NEXT M
170 FOR M=1 TO 4
180 HSCREEN M:HCLS 0:PALETTE 0,0:PALETTE 1,63:HCOLOR 1,0
190 IF M=1 THEN HPRINT (1,1),"HSCREEN 1 - 320 X 192 - 4 COLOR"
200 IF M=2 THEN HPRINT (1,1),"HSCREEN 2 - 320 X 192 - 16 COLOR"
210 IF M=3 THEN HPRINT (1,1),"HSCREEN 3 - 640 X 192 - 2 COLOR"
220 IF M=4 THEN HPRINT (1,1),"HSCREEN 4 - 640 X 192 - 4 COLOR"
230 HPRINT (1,4),"TEXT AND PALETTE TEST"
240 HPRINT (1,22),"PRESS ANY KEY FOR NEXT MODE"
250 GOSUB 9000
260 NEXT M
270 HSCREEN 0:WIDTH 32:CLS
280 RUN "TESTMENU"
9000 IF INKEY$<>"" THEN 9000
9010 IF INKEY$="" THEN 9010
9020 IF INKEY$<>"" THEN 9020
9030 RETURN
