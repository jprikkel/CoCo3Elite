10 CLS
20 PRINT "KEYBOARD AND JOYSTICK TEST"
30 PRINT "F7: RIGHT JOYSTICK W A S D F"
40 PRINT "F8: LEFT JOYSTICK ARROWS/SPACE"
50 PRINT "ENTER: MENU  ESC/BREAK: STOP"
60 A$=INKEY$
70 PRINT @160,"KEY: ";
80 IF A$="" THEN PRINT "---";:GOTO 110
90 PRINT RIGHT$("  "+STR$(ASC(A$)),3);
100 IF A$=CHR$(13) THEN RUN "TESTMENU"
110 PRINT @192,"JOY 0:";JOYSTK(0);"  JOY 1:";JOYSTK(1);"  ";
120 PRINT @224,"JOY 2:";JOYSTK(2);"  JOY 3:";JOYSTK(3);"  ";
130 PRINT @256,"BUTTON 1:";BUTTON(0);" BUTTON 2:";BUTTON(1);"  ";
140 GOTO 60
