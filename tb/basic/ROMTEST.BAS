10 REM SYSTEM ROM AND VECTOR COMPATIBILITY TEST
20 CLS:PRINT "SYSTEM ROM/VECTOR TEST":PRINT:F=0
30 PRINT "RESET VECTOR...";
40 H=PEEK(65534):L=PEEK(65535):V=H*256+L
50 PRINT "$";HEX$(V)
60 IF V=35867 THEN PRINT "RESET VECTOR: PASS" ELSE PRINT "RESET VECTOR: FAIL":F=1
70 PRINT "HARDWARE VECTORS...";
80 FOR A=65522 TO 65535 STEP 2
90 V=PEEK(A)*256+PEEK(A+1)
100 IF V<32768 THEN F=1
110 NEXT A
120 IF F=0 THEN PRINT "PASS" ELSE PRINT "FAIL"
130 PRINT "ROM WRITE PROTECT...";
140 A=65535:V=PEEK(A):POKE A,V XOR 255
150 IF PEEK(A)=V THEN PRINT "PASS" ELSE PRINT "FAIL":F=1
160 PRINT "DISK BASIC ROM...";
170 S=0:FOR A=49152 TO 49183:S=S+PEEK(A):NEXT A
180 IF S<>0 AND S<>8160 THEN PRINT "PASS $";HEX$(S) ELSE PRINT "FAIL":F=1
190 PRINT
200 IF F=0 THEN PRINT "SYSTEM ROM TESTS: PASS" ELSE PRINT "SYSTEM ROM TESTS: FAIL"
210 PRINT:PRINT "PRESS ANY KEY FOR MENU"
220 IF INKEY$="" THEN 220
230 RUN "TESTMENU"
