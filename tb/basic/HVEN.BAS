10 WIDTH 32:CLEAR 200,&H5FFF:CLS
20 PRINT "HVEN SCROLL TEST V2"
30 PRINT "512-PIXEL VIRTUAL ROWS"
40 PRINT "A/D  STEP LEFT/RIGHT"
50 PRINT "SPACE  AUTO SCROLL ON/OFF"
60 PRINT "Q  RETURN TO TEST MENU"
70 LOADM "HVENFILL"
80 PRINT "PRESS A KEY TO START"
90 IF INKEY$="" THEN 90
100 HSCREEN 2:HCLS 0
110 FOR I=0 TO 15:READ P:PALETTE I,P:NEXT I
120 EXEC &H6000
130 O=0:M=0:D=1
140 A$=INKEY$:S=0
150 IF A$="Q" OR A$="q" THEN 300
160 IF A$=" " THEN M=1-M
170 IF A$="A" OR A$="a" THEN D=-1:S=-8
180 IF A$="D" OR A$="d" THEN D=1:S=8
190 IF M=1 AND S=0 THEN S=D
200 O=O+S
210 IF O>127 THEN O=O-128
220 IF O<0 THEN O=O+128
230 POKE &HFF9F,128+O
240 FOR T=1 TO 20:NEXT T
250 GOTO 140
260 DATA 0,9,18,27,36,45,54,63,7,14,21,28,35,42,49,56
300 POKE &HFF9F,0:HSCREEN 0:WIDTH 32:CLS
310 RUN "TESTMENU"
